// ============================================================================
// MUSIC-IN-A-BOX — CORE SCHEMA
// ============================================================================
// Design principle: Organization is the tenant root. Every domain table
// carries an `organizationId`. Today there is exactly one Organization row
// (your label/artist). Later, onboarding a second label or a solo indie
// artist is just another row — no migration, no schema change, no rewrite.
//
// The ONE deliberate exception is the sync marketplace (SyncListing /
// DealRoom), which is designed to cross tenant boundaries on purpose,
// explicitly, and auditably — everything else stays strictly siloed.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANT ROOT
// ============================================================================

enum OrganizationType {
  LABEL       // multi-artist roster
  ARTIST      // solo indie artist acting as their own tenant
  PUBLISHER
  SYNC_BUYER  // external supervisor/agency org, no catalog of their own
  ENTERPRISE
}

enum OrganizationPlan {
  SOLO
  INDIE
  LABEL_SERVICES
  ENTERPRISE
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  type         OrganizationType @default(ARTIST)
  plan         OrganizationPlan @default(SOLO)
  isWhiteLabel Boolean          @default(false)
  domain       String?          @unique // custom domain, for later white-label tenants
  logoUrl      String?
  settings     Json?            // theme, feature flags, per-org branding

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  roles               Role[]
  artists             Artist[]
  labels              Label[]
  publishers          Publisher[]
  songs               Song[]
  tracks              Track[]
  releases            Release[]
  projects            Project[]
  assets              Asset[]
  rights              RightsRecord[]
  splitSheets         SplitSheet[]
  royaltyStatements   RoyaltyStatement[]
  dealRoomsAsLicensor DealRoom[]         @relation("LicensorOrg")
  dealRoomsAsBuyer    DealRoom[]         @relation("BuyerOrg")
  venues              Venue[]
  tours               Tour[]
  orders              Order[]
  products            Product[]
  cmsPages            CmsPage[]
  notifications       Notification[]
  ledgerAccounts      LedgerAccount[]
  ledgerTransactions  LedgerTransaction[]
  aiJobs              AiJob[]
  collabDocs          CollabDoc[]

  @@index([type])
}

// ============================================================================
// IDENTITY — Users are global; Memberships are what scope them to a tenant
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships    Membership[]
  hostedSessions Session[]    @relation("SessionHost")
}

/// The join table that makes multi-tenancy work. A user can hold zero, one,
/// or many memberships — e.g. a session musician invited into three
/// different labels' projects keeps one User row and three Memberships,
/// each with its own Role scoped to that Organization.
model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  roleId         String

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum SystemRoleName {
  OWNER
  LABEL_ADMIN
  ARTIST
  MANAGER
  A_AND_R
  SYNC_AGENT
  PUBLISHER
  ACCOUNTANT
  MUSIC_SUPERVISOR
  DSP_PARTNER
  BOOKING_AGENT
  EDUCATOR
  STUDENT
}

/// Roles are org-scoped (not global) so that a label can eventually define
/// custom roles without touching every other tenant. System roles are
/// seeded per-org at creation time.
model Role {
  id             String         @id @default(cuid())
  organizationId String
  name           SystemRoleName

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]
  permissions  Permission[]

  @@unique([organizationId, name])
}

model Permission {
  id     String @id @default(cuid())
  action String // e.g. "release:publish", "royalty:view", "sync:approve"
  roles  Role[]
}

// ============================================================================
// CATALOG ROOT ENTITIES — every one of these is org-scoped
// ============================================================================

model Artist {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  bio            String?
  avatarUrl      String?

  organization Organization       @relation(fields: [organizationId], references: [id])
  tracks       Track[]
  releases     Release[]
  projects     Project[]
  splitShares  SplitParticipant[]

  @@index([organizationId])
}

model Label {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  imprintOfId    String? // self-relation: parent-label -> sub-imprint hierarchy

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Label?       @relation("Imprints", fields: [imprintOfId], references: [id])
  imprints     Label[]      @relation("Imprints")

  @@index([organizationId])
}

model Publisher {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  ipiNumber      String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ============================================================================
// SONG / TRACK / RELEASE
// ============================================================================

model Song {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  iswc           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  tracks       Track[]
  splitSheets  SplitSheet[]

  @@index([organizationId])
}

/// Governs whether a track is even eligible to appear in the cross-tenant
/// SyncListing table below. PRIVATE/CATALOG_ONLY never leave this org's
/// own queries; only SYNC_MARKETPLACE does, and only via an explicit
/// publish action (Section 7.6-style automatic package generation).
enum SyncVisibility {
  PRIVATE
  CATALOG_ONLY
  SYNC_MARKETPLACE
}

model Track {
  id             String  @id @default(cuid())
  organizationId String
  songId         String?
  artistId       String
  releaseId      String?
  projectId      String?

  title       String
  isrc        String?
  bpm         Int?
  musicalKey  String?
  genre       String?
  mood        String?
  durationSec Int?

  syncVisibility SyncVisibility @default(PRIVATE)

  organization Organization @relation(fields: [organizationId], references: [id])
  song         Song?        @relation(fields: [songId], references: [id])
  artist       Artist       @relation(fields: [artistId], references: [id])
  release      Release?     @relation(fields: [releaseId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  assets      Asset[]
  metadata    Metadata?
  rights      RightsRecord[]
  splitSheets SplitSheet[]
  syncListing SyncListing?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([syncVisibility])
}

model Release {
  id             String    @id @default(cuid())
  organizationId String
  artistId       String
  title          String
  upc            String?
  releaseDate    DateTime?
  status         String    @default("draft") // draft | in_review | live | takedown

  organization Organization @relation(fields: [organizationId], references: [id])
  artist       Artist       @relation(fields: [artistId], references: [id])
  tracks       Track[]

  @@index([organizationId])
}

// ============================================================================
// STUDIO / COLLABORATION
// ============================================================================

model Project {
  id             String  @id @default(cuid())
  organizationId String
  artistId       String?
  name           String

  organization Organization @relation(fields: [organizationId], references: [id])
  artist       Artist?      @relation(fields: [artistId], references: [id])
  tracks       Track[]
  sessions     Session[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Session {
  id        String    @id @default(cuid())
  projectId String
  hostId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id])
  host    User    @relation("SessionHost", fields: [hostId], references: [id])
}

// ============================================================================
// ASSETS & METADATA
// ============================================================================

enum AssetType {
  AUDIO
  ARTWORK
  VIDEO
  STEM
  CONTRACT
  PRESS
  DOCUMENT
}

model Asset {
  id             String    @id @default(cuid())
  organizationId String
  trackId        String?
  type           AssetType
  bucket         String    // maps to a Supabase Storage bucket
  storageKey     String
  checksum       String?

  organization Organization @relation(fields: [organizationId], references: [id])
  track        Track?       @relation(fields: [trackId], references: [id])
  splitSheets  SplitSheet[] // back-reference for SplitSheet.pdfAssetId

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Metadata {
  id      String @id @default(cuid())
  trackId String @unique
  track   Track  @relation(fields: [trackId], references: [id])

  // Sync-searchable creative/legal fields
  vocalGender      String?
  instrumentation  String?
  language         String?
  explicit         Boolean  @default(false)
  oneStopClearance Boolean  @default(false)
  keywords         String[]
  aiAssisted       Boolean  @default(false)
  aiGenerated      Boolean  @default(false)
}

// ============================================================================
// RIGHTS & SPLITS
// ============================================================================

enum RightsType {
  MASTER
  PUBLISHING
  NEIGHBORING
  MECHANICAL
  SYNC
}

model RightsRecord {
  id             String     @id @default(cuid())
  organizationId String
  trackId        String
  type           RightsType
  owner          String
  territory      String     @default("WORLDWIDE")
  ownershipPct   Float
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  track        Track        @relation(fields: [trackId], references: [id])

  @@index([organizationId])
}

model SplitSheet {
  id             String  @id @default(cuid())
  organizationId String
  songId         String?
  trackId        String?
  status         String  @default("draft") // draft | pending_signatures | executed
  pdfAssetId     String? // set once generate-split-sheet-pdf edge function runs

  organization Organization       @relation(fields: [organizationId], references: [id])
  song         Song?              @relation(fields: [songId], references: [id])
  track        Track?             @relation(fields: [trackId], references: [id])
  pdfAsset     Asset?             @relation(fields: [pdfAssetId], references: [id])
  participants SplitParticipant[]
  signatures   SplitSignature[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

/// One row per required signer. A split sheet is "executed" only once every
/// participant with requiresSignature = true has signedAt set — this is
/// what the PDF export and the DealRoom contract step both check before
/// treating ownership as final.
model SplitSignature {
  id                    String    @id @default(cuid())
  splitSheetId          String
  participantId         String
  signedAt              DateTime?
  signatureImageAssetId String?
  ipAddress             String?

  splitSheet  SplitSheet       @relation(fields: [splitSheetId], references: [id])
  participant SplitParticipant @relation(fields: [participantId], references: [id])

  @@index([splitSheetId])
}

model SplitParticipant {
  id           String  @id @default(cuid())
  splitSheetId String
  artistId     String?
  role         String  // writer | producer | artist | publisher ...
  percentage   Float
  requiresSignature Boolean @default(true)

  splitSheet SplitSheet       @relation(fields: [splitSheetId], references: [id])
  artist     Artist?          @relation(fields: [artistId], references: [id])
  signatures SplitSignature[]
}

// ============================================================================
// ROYALTIES
// ============================================================================

model RoyaltyStatement {
  id             String   @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("pending") // pending | frozen | paid
  totalAmount    Decimal? @db.Decimal(12, 2)

  organization Organization      @relation(fields: [organizationId], references: [id])
  lineItems    RoyaltyLineItem[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model RoyaltyLineItem {
  id                 String  @id @default(cuid())
  royaltyStatementId String
  trackId            String?
  participantId      String?
  source             String  // DSP name | sync fee | direct-to-fan | ...
  amount             Decimal @db.Decimal(12, 2)

  royaltyStatement RoyaltyStatement @relation(fields: [royaltyStatementId], references: [id])
}

// ============================================================================
// SYNC MARKETPLACE — the deliberate, audited cross-tenant exception
// ============================================================================

/// A SyncListing is the ONE place a tenant-scoped Track becomes readable
/// outside its own Organization. It only exists if a Track was explicitly
/// set to SyncVisibility.SYNC_MARKETPLACE and published. Every other model
/// in this schema is strictly org-scoped; this is not a leak, it's the
/// one intentional door, and it's easy to audit because it's one table.
model SyncListing {
  id          String   @id @default(cuid())
  trackId     String   @unique
  publishedAt DateTime @default(now())
  status      String   @default("available") // available | on_hold | withdrawn

  track     Track      @relation(fields: [trackId], references: [id])
  dealRooms DealRoom[]
}

model DealRoom {
  id               String  @id @default(cuid())
  syncListingId    String
  licensorOrgId    String  // the org that owns the track
  buyerOrgId       String? // the requesting org, IF they're a platform tenant
  buyerContactName String? // fallback for a one-off external supervisor
  status           String  @default("requested")
  // requested -> reviewing -> approved -> negotiating -> contracted
  // -> signed -> invoiced -> delivered -> tracking

  syncListing SyncListing   @relation(fields: [syncListingId], references: [id])
  licensorOrg Organization  @relation("LicensorOrg", fields: [licensorOrgId], references: [id])
  buyerOrg    Organization? @relation("BuyerOrg", fields: [buyerOrgId], references: [id])

  createdAt DateTime @default(now())

  @@index([licensorOrgId])
  @@index([buyerOrgId])
}

// ============================================================================
// TOURING
// ============================================================================

model Venue {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  capacity       Int?
  city           String?
  country        String?

  organization Organization @relation(fields: [organizationId], references: [id])
  tours        Tour[]

  @@index([organizationId])
}

model Tour {
  id             String    @id @default(cuid())
  organizationId String
  venueId        String?
  artistId       String?
  date           DateTime?
  status         String    @default("hold") // hold | confirmed | complete

  organization Organization @relation(fields: [organizationId], references: [id])
  venue        Venue?       @relation(fields: [venueId], references: [id])

  @@index([organizationId])
}

// ============================================================================
// COMMERCE
// ============================================================================

model Product {
  id             String @id @default(cuid())
  organizationId String
  name           String
  priceCents     Int
  type           String // merch | vinyl | digital_bundle

  organization Organization @relation(fields: [organizationId], references: [id])
  orders       Order[]

  @@index([organizationId])
}

model Order {
  id             String @id @default(cuid())
  organizationId String
  productId      String
  buyerEmail     String
  amountCents    Int
  status         String @default("pending")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ============================================================================
// CMS
// ============================================================================

model CmsPage {
  id             String @id @default(cuid())
  organizationId String
  slug           String
  title          String
  contentJson    Json

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, slug])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  payload        Json?
  readAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ============================================================================
// LEDGER — double-entry accounting, ledger-cli principles
// ============================================================================
// Every money-moving event (a DSP payout landing, a sync fee, a split
// payout, a withdrawal) is a Transaction with two or more Entries whose
// signed amounts sum to zero. Nothing ever mutates a "balance" column —
// balance is always the sum of Entries for an Account, computed at read
// time (or in a materialized view once volume demands it). This is the
// same principle ledger-cli/hledger/beancount use: the ledger is an
// immutable, append-only log; you never edit history, you post a
// correcting entry.

enum LedgerAccountType {
  ASSET       // e.g. "Cash", "Royalties Receivable"
  LIABILITY   // e.g. "Royalties Payable — Artist X"
  EQUITY
  REVENUE     // e.g. "Master Streaming Income", "Sync Fee Income"
  EXPENSE     // e.g. "Distribution Fees", "Platform Commission"
}

/// The chart of accounts. Platform-level accounts (owner = PLATFORM) and
/// per-participant payable accounts (owner = PARTICIPANT, ownerId =
/// SplitParticipant.id) both live here, scoped to the org that owns the
/// catalog the money relates to.
model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String
  code           String            // chart-of-accounts code, e.g. "2100-ROYALTIES-PAYABLE"
  name           String
  type           LedgerAccountType
  ownerType      String            @default("PLATFORM") // PLATFORM | ARTIST | PARTICIPANT
  ownerId        String?           // Artist.id or SplitParticipant.id when scoped to a person
  currency       String            @default("USD")

  organization Organization  @relation(fields: [organizationId], references: [id])
  entries      LedgerEntry[] // filter by `direction` for "all debits" vs "all credits"

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([ownerType, ownerId])
}

enum LedgerSourceType {
  DSP_ROYALTY
  SYNC_FEE
  DIRECT_TO_FAN
  SPLIT_PAYOUT
  WITHDRAWAL
  PLATFORM_COMMISSION
  ADJUSTMENT
}

/// A Transaction is the atomic, balanced unit — it either has all its
/// Entries or none of them (wrap the insert in a single db transaction at
/// the application layer). sourceType + sourceId point back at whatever
/// business event caused the posting (a RoyaltyStatement, a DealRoom, etc.)
/// without a hard FK, since the source table varies.
model LedgerTransaction {
  id             String           @id @default(cuid())
  organizationId String
  date           DateTime         @default(now())
  memo           String?
  sourceType     LedgerSourceType
  sourceId       String?

  organization Organization  @relation(fields: [organizationId], references: [id])
  entries      LedgerEntry[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([sourceType, sourceId])
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id            String               @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(12, 2) // always positive; direction carries the sign

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount    @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
}

// ============================================================================
// ASYNC AI JOBS — stem separation, mastering, voice, song-idea generation
// ============================================================================
// Demucs, Matchering, and RVC are compute-heavy (GPU-friendly) and do NOT
// belong in a Vercel Edge Function or a Supabase Edge Function (Deno,
// no GPU, short timeout). They run as an async worker job (a queue +
// container service — Modal, Replicate, Fly.io, or a self-hosted GPU box).
// This table is the queue's source of truth so the UI can poll or
// subscribe (Supabase Realtime) for job status instead of blocking.

enum AiJobType {
  STEM_SEPARATION   // Demucs / Spleeter
  MASTERING         // Matchering / Roex
  VOICE_CONVERSION  // RVC
  SONG_IDEA         // Magenta MusicVAE / MelodyRNN
  METADATA_ANALYSIS // Essentia.js / Librosa (BPM, key, mood)
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AiJob {
  id             String      @id @default(cuid())
  organizationId String
  trackId        String?
  type           AiJobType
  status         AiJobStatus @default(QUEUED)
  inputAssetId   String?
  outputAssetId  String?
  errorMessage   String?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([organizationId])
  @@index([status])
}

// ============================================================================
// COLLABORATIVE DOCS — Writers' Room (Yjs)
// ============================================================================
// Yjs documents are binary CRDT state, not relational data — Postgres
// stores the pointer, Supabase Storage (or a dedicated y-websocket server
// with its own persistence) stores the actual binary snapshot. This row
// is what ties a Yjs room back to a Project/Song and enforces org scoping
// for who's allowed to connect to that room at all (checked before the
// websocket upgrade, not after).

model CollabDoc {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  songId         String?
  roomName       String   @unique // the y-websocket / y-webrtc room identifier
  snapshotAssetId String? // periodic binary snapshot, for cold starts / backup

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}
