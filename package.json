{
  "name": "musicbox-monorepo",
  "version": "0.2.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "cd packages/database && bun run generate",
    "db:push": "cd packages/database && bun run push",
    "db:migrate": "cd packages/database && bun run migrate",
    "db:reset": "cd packages/database && bun run reset",
    "db:studio": "cd packages/database && bun run studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
